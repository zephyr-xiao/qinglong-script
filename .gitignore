# 依赖目录（体积大，由 package-lock.json / requirements.txt 重建）
node_modules/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 验证码调试产物
gptqtcool_checkin/artifacts/

# 凭证与缓存（个人账号信息，严禁提交）
.token/
*_cookie.json
cookie_*.json
cookies.json
cookies/
*.log
# log4js 轮转备份（.log.1.gz 等）不受上面 *.log 匹配
*.log.*
# HAR 抓包文件含完整 Cookie
*.har
# E-Hentai 等脚本的明文 Cookie 文本缓存
*_cookie.txt
.env

# 运行期登录态与运行数据（个人账号信息，严禁提交）
*_token.json
# 芯幻签到原子写临时文件（中断时可能残留明文 token，必须一并忽略）
xhcyv_checkin/.xhcyv_token.*
*_state.json
*_log.txt
replied_posts.json

# 运行锁（防并发/重复消耗站点登录配额，运行期自动生成）
pt-checkin/*.lock
wnflb_fx_checkin/*.lock

# 账号清单（含明文密码，严禁提交）与单元测试临时产物
*_accounts.txt
.test_tmp/

# 浏览器登录调试截屏（DEBUG 模式产出）
_ikuuu_debug/

# 点选验证码解法器调试产物（合成图 + 模型原始回复）
_vlm_debug/

# 采蘑菇回帖脚本调试截屏（CAIMOGU_DEBUG=true 产出）
_caimogu_debug_*.png

# ZodGame 签到调试产物（ZODGAME_DEBUG=true 产出，含完整响应报文）
_zodgame_debug/

# IDE
.vscode/
.idea/
*.swp
# 两段写残留的临时文件（可能含明文 Cookie/token，崩溃时残留）
*.part
*.json.tmp
