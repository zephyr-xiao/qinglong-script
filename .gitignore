# 依赖目录（体积大，由 package-lock.json / requirements.txt 重建）
node_modules/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 验证码调试产物
gptqtcool_checkin/artifacts/

# 凭证与缓存（个人账号信息，严禁提交）
.token/
*_cookie.json
cookie_*.json
cookies.json
cookies/
*.log
.env

# 运行期登录态与运行数据（个人账号信息，严禁提交）
*_token.json
*_state.json
*_log.txt
replied_posts.json

# 运行锁（防并发/重复消耗站点登录配额，运行期自动生成）
pt-checkin/*.lock

# 账号清单（含明文密码，严禁提交）与单元测试临时产物
*_accounts.txt
.test_tmp/

# 浏览器登录调试截屏（DEBUG 模式产出）
_ikuuu_debug/

# 点选验证码解法器调试产物（合成图 + 模型原始回复）
_vlm_debug/

# 采蘑菇回帖脚本调试截屏（CAIMOGU_DEBUG=true 产出）
_caimogu_debug_*.png

# ZodGame 签到调试产物（ZODGAME_DEBUG=true 产出，含完整响应报文）
_zodgame_debug/

# IDE
.vscode/
.idea/
*.swp
